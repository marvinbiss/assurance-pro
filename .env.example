# ============================================================================
# ASSURANCE PRO — Variables d'environnement (cabinet de courtage ORIAS)
# ============================================================================
# Copier ce fichier vers .env.local (déjà dans .gitignore) et remplir.
# NE JAMAIS commit .env.local.
# ============================================================================

# ── Base ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://assurance-pro.fr
NEXT_PUBLIC_SITE_NAME=Assurance Pro
NODE_ENV=production

# ── Identité ORIAS / légale (rendue dans /mentions-legales, /fic) ──────────
NEXT_PUBLIC_ORIAS_NUMBER=07 0XX XXX
NEXT_PUBLIC_ORIAS_URL=https://www.orias.fr/welcome
NEXT_PUBLIC_LEGAL_EDITOR=Assurance Pro SAS
NEXT_PUBLIC_LEGAL_SIRET=XXX XXX XXX 00000
NEXT_PUBLIC_LEGAL_RCS=RCS Paris
NEXT_PUBLIC_LEGAL_CAPITAL=10 000 €
NEXT_PUBLIC_LEGAL_ADDRESS=XX rue de la Paix, 75000 Paris
NEXT_PUBLIC_LEGAL_TVA=FRXX XXX XXX XXX

COMPANY_LEGAL_NAME=Assurance Pro SAS
COMPANY_FORME_JURIDIQUE=SAS
COMPANY_CAPITAL_SOCIAL=10000
COMPANY_SIRET=
COMPANY_RCS=
COMPANY_TVA=
COMPANY_ADDRESS=
COMPANY_PHONE=06 51 85 89 30
COMPANY_DIRECTEUR_PUBLICATION=
COMPANY_FOUNDING_DATE=2026-01-01
COMPANY_STATUS=launched

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://postgres:...@db.xxx.supabase.co:5432/postgres

# ── Email transactionnel (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=Assurance Pro <noreply@assurance-pro.fr>
COURTIER_INBOX=leads@assurance-pro.fr
RECLAMATIONS_INBOX=reclamations@assurance-pro.fr

# ── Sécurité ────────────────────────────────────────────────────────────────
# Tous les secrets ci-dessous : `openssl rand -hex 32` (>= 32 chars). Aucune
# réutilisation autorisée — chaque rôle a sa primitive cryptographique dédiée.
CRON_SECRET=
ADMIN_API_TOKEN=
GDPR_DELETE_TOKEN_SECRET=
GDPR_EXPORT_TOKEN_SECRET=
REVALIDATE_SECRET=
# Cross-domain JWT (partagé avec ServicesArtisans, >= 32 chars).
CROSS_DOMAIN_JWT_SECRET=
CROSS_DOMAIN_JWT_ISSUER=servicesartisans.fr
CROSS_DOMAIN_JWT_AUDIENCE=assurance-pro.fr

# ── Rate-limiting (Upstash Redis recommandé en prod) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Indexation Bing/Yandex ──────────────────────────────────────────────────
INDEXNOW_API_KEY=

# ── Analytics & marketing (chargés POST-consent uniquement) ─────────────────
NEXT_PUBLIC_GTM_ID=GTM-THV3KZ8N
NEXT_PUBLIC_META_PIXEL_ID=

# ── APIs externes (toutes optionnelles — données pour les piliers) ──────────
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
INSEE_API_TOKEN=
AHREFS_API_TOKEN=

# ── LLM (pipeline contenu pSEO, optionnel) ──────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Observabilité — Sentry (optionnel, no-op sans DSN) ──────────────────────
# Crée un projet sur https://sentry.io (Next.js platform), récupère le DSN.
# SENTRY_DSN : utilisé côté serveur (Node + Edge runtimes), strict private.
# NEXT_PUBLIC_SENTRY_DSN : exposé au bundle CLIENT (visible dans browser).
#
# ⚠️ SÉCURITÉ : NEXT_PUBLIC_SENTRY_DSN DOIT être un DSN distinct, scopé
# à un projet Sentry "client-side only" avec scope minimal (send events,
# NO source map access, NO admin). Un DSN exposé permet à n'importe qui
# d'envoyer des events vers ton projet → pollution + quota consommé.
# Best practice Sentry : projet séparé "vivos-frontend" pour le client.
#
# SENTRY_AUTH_TOKEN/ORG/PROJECT activent l'upload des sourcemaps au build
# (recommandé en prod sur Vercel). AUTH_TOKEN est strict private.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Lead scoring API (internal CRM access) ─────────────────────────────────
# Clé API pour /api/leads/score (header X-API-Key).
# Génère via : openssl rand -hex 32
# Sans cette clé, l'endpoint refuse TOUTE requête (fail-closed).
LEAD_SCORING_API_KEY=

# ── LLM Providers (RAG chatbot + multi-model) ──────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
