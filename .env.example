# ============================================================================
# ASSURANCE PRO — Variables d'environnement
# ============================================================================
# Copie ce fichier vers .env.local et remplis les valeurs
# JAMAIS commit .env.local (déjà dans .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# 🌐 NEXT.JS — Configuration de base
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Assurance Pro
NODE_ENV=development

# ----------------------------------------------------------------------------
# 🗄️ SUPABASE — Backend principal
# ----------------------------------------------------------------------------
# Récupérer depuis : https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (SERVER ONLY — JAMAIS exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database direct connection (pour migrations)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Webhook secret (pour revalidation Next.js depuis Supabase)
SUPABASE_WEBHOOK_SECRET=your-random-secret-here

# ----------------------------------------------------------------------------
# 🤖 ANTHROPIC — Claude Sonnet 4.6 (génération contenu LLM)
# ----------------------------------------------------------------------------
# Récupérer depuis : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ----------------------------------------------------------------------------
# 🔍 AHREFS — KW research (clé déjà active dans ~/btp-pseo/.env)
# ----------------------------------------------------------------------------
AHREFS_API_TOKEN=...

# ----------------------------------------------------------------------------
# 🏛️ APIs OFFICIELLES TIER 1 (gratuites)
# ----------------------------------------------------------------------------

# INSEE Sirene API (token OAuth gratuit)
# Inscription : https://api.insee.fr/catalogue/
INSEE_API_KEY=
INSEE_API_SECRET=
INSEE_API_TOKEN=

# Légifrance / DILA API (token gratuit data.gouv.fr)
# Inscription : https://aife.economie.gouv.fr/
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=

# ORIAS (registre courtiers — scraping autorisé, pas d'API officielle)
# https://www.orias.fr — pas de token requis

# ----------------------------------------------------------------------------
# 💰 APIs PREMIUM TIER 3
# ----------------------------------------------------------------------------

# Pappers (solidité financière assureurs)
PAPPERS_API_KEY=

# Trustpilot (avis vérifiés ISO 20488)
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=

# DataForSEO ou SerpAPI (SERP monitoring + AIO tracking)
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=

# OpenAI GPT-5 (cross-validation anti-hallucination)
OPENAI_API_KEY=

# ----------------------------------------------------------------------------
# 🛡️ ASSUREURS PARTENAIRES (APIs tarifeurs — sous convention courtage)
# ----------------------------------------------------------------------------

# Hiscox API
HISCOX_API_URL=
HISCOX_API_KEY=
HISCOX_BROKER_ID=

# April Pro
APRIL_API_URL=
APRIL_API_KEY=
APRIL_BROKER_ID=

# Wakam (assurtech)
WAKAM_API_URL=
WAKAM_API_KEY=

# Stello
STELLO_API_URL=
STELLO_API_KEY=

# (Ajouter MMA, Generali, AXA, Allianz, MAAF, SMABTP au fil des conventions)

# ----------------------------------------------------------------------------
# 💳 STRIPE — Paiements (réutilisé de ServicesArtisans)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----------------------------------------------------------------------------
# 📧 RESEND — Emails transactionnels
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=contact@assurance-pro.fr
RESEND_REPLY_TO=contact@assurance-pro.fr

# ----------------------------------------------------------------------------
# 📱 SMS — Provider (à choisir : Brevo / OVHcloud SMS / Twilio)
# ----------------------------------------------------------------------------
SMS_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER=AssurancePro

# ----------------------------------------------------------------------------
# 🔐 AUTH / SECURITY
# ----------------------------------------------------------------------------

# JWT secret pour cross-domain ServicesArtisans → Assurance Pro
CROSS_DOMAIN_JWT_SECRET=your-shared-secret-with-servicesartisans
CROSS_DOMAIN_JWT_ISSUER=servicesartisans.fr
CROSS_DOMAIN_JWT_AUDIENCE=assurance-pro.fr

# IndexNow (Bing/Yandex notification)
INDEXNOW_KEY=your-indexnow-key

# ----------------------------------------------------------------------------
# 📊 ANALYTICS & MONITORING
# ----------------------------------------------------------------------------

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vercel Analytics (auto)

# Sentry (monitoring erreurs)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----------------------------------------------------------------------------
# ⚙️ FEATURE FLAGS
# ----------------------------------------------------------------------------
ENABLE_LLM_GENERATION=false
ENABLE_AHREFS_SYNC=false
ENABLE_LEGIFRANCE_SYNC=false
ENABLE_ORIAS_SYNC=false
ENABLE_AQC_SYNC=false
ENABLE_CROSS_DOMAIN_JWT=false
ENABLE_DEBUG_LOGS=true

# ----------------------------------------------------------------------------
# 🛡️ CONFORMITÉ ACPR / ORIAS / RGPD
# ----------------------------------------------------------------------------

# Numéro ORIAS du courtier (à afficher sur 100% des pages)
NEXT_PUBLIC_ORIAS_NUMBER=07 0XX XXX
NEXT_PUBLIC_ORIAS_URL=https://www.orias.fr/welcome

# Cabinet RCP renforcée
RCP_INSURER=
RCP_POLICY_NUMBER=
RCP_AMOUNT_PER_CLAIM=5000000
RCP_AMOUNT_PER_YEAR=7500000

# Adhésion association agréée (CSCA, Planète CSCA, Endya, AC2A)
ASSOCIATION_AGREEE=CSCA

# DPO externe
DPO_EMAIL=dpo@assurance-pro.fr
DPO_NAME=

# ----------------------------------------------------------------------------
# 🌐 CORS & RATE LIMITING
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://assurance-pro.fr,https://servicesartisans.fr
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------------------------------------------
# 🔄 CRON JOBS (Vercel Cron / Supabase Edge Functions)
# ----------------------------------------------------------------------------
CRON_SECRET=your-random-cron-secret
