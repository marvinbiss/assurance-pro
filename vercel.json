{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "functions": {
    "src/app/**/*.tsx": {
      "maxDuration": 30
    },
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-ahrefs",
      "schedule": "0 3 1 1,4,7,10 *"
    },
    {
      "path": "/api/cron/refresh-jurisprudence",
      "schedule": "0 4 1 * *"
    },
    {
      "path": "/api/cron/refresh-orias",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/sitemap-health",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/indexnow-submit",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/sla-reclamations",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/purge-tokens",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/nurture-emails",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
